# HIREX Configuration
PROJECT_NAME="HIREX AI Interview Workflow & Evaluation API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database (SQLite default or PostgreSQL: postgresql://user:password@localhost:5432/hirex)
DATABASE_URL="sqlite:///./hirex.db"
DB_ECHO=false

# Security & Authentication
SECRET_KEY="hirex-super-secret-production-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Adapter & Evaluation
LLM_ADAPTER_TYPE="deterministic" # 'deterministic' or 'openai'
LLM_ADAPTER_VERSION="hirex-adapter-v1.2.0"
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2
OPENAI_API_KEY=""

# Rubric Bounds
SCORE_MIN=1
SCORE_MAX=5

# LiveKit Video & Audio Mock/Integration
LIVEKIT_API_KEY="livekit_hirex_key"
LIVEKIT_API_SECRET="livekit_hirex_secret_32_character_key_min"
LIVEKIT_WEBHOOK_SECRET="whsec_hirex_webhook_secret_key"

# Concurrency & Idempotency
IDEMPOTENCY_LOCK_SECONDS=60
